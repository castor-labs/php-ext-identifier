{
  "name": "castor/ext-identifier",
  "version": "0.3.0",
  "type": "php-ext",
  "description": "High-performance 128-bit identifier extension for PHP (UUIDs and ULIDs)",
  "keywords": [
    "uuid",
    "ulid",
    "identifier",
    "guid",
    "php-extension",
    "128-bit",
    "rfc4122",
    "rfc9562"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Matias Navarro-Carter",
      "email": "mnavarrocarter@gmail.com"
    }
  ],
  "php-ext": {
    "extension-name": "identifier",
    "support-zts": true,
    "support-nts": true,
    "os-families-exclude": [
      "windows"
    ],
    "download-url-method": [
      "pre-packaged-binary"
    ]
  },
  "require": {
    "php": ">=8.3.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Identifier\\": "test/"
    }
  },
  "scripts": {
    "bench": "phpbench run",
    "test": "php -d extension=./modules/identifier.so vendor/bin/phpunit"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "carthage-software/mago": "^1.30",
    "phpbench/phpbench": "^1.6",
    "symfony/uid": "^8.1",
    "ramsey/uuid": "^4.9"
  }
}
